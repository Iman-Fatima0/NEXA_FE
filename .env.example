# Origin of your NestJS API (no trailing slash). When set, BFF routes proxy here with Bearer nexa_access_token when present.
NEXT_PUBLIC_BACKEND_API_BASE_URL=http://localhost:3000
# Canonical public site base (Next app URL, no trailing slash) — localhost only for now
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Server-only BFF → Nest (optional; defaults to NEXT_PUBLIC_BACKEND_API_BASE_URL)
BACKEND_INTERNAL_URL=http://127.0.0.1:3000
# Optional upstream overrides (defaults match Nest websites module):
# BACKEND_USER_WEBSITES_PATH=/websites
# BACKEND_USER_WEBSITE_DETAIL_PATH=/websites/:id
# PUT /api/user/websites/:id → /websites/:id/builder (fixed in upstream-paths)
# POST …/publish → /websites/:id/publish | …/generate-content → /websites/:id/generate-content
# BACKEND_WEBSITE_TEMPLATES_PATH=/websites/templates
# Optional server-only path for the dashboard aggregate (default /dashboard). Example: /api/v1/me/dashboard
# Optional path overrides (defaults match NestJS: /auth/me, /bots, /websites, /users)
# BACKEND_AUTH_ME_PATH=/auth/me
# BACKEND_USER_BOTS_PATH=/bots
# BACKEND_USER_WEBSITES_PATH=/websites
# BACKEND_USERS_PATH=/users
NEXT_PUBLIC_WEBSITE_API_BASE_URL=
NEXT_PUBLIC_CHATBOT_API_BASE_URL=
NEXT_PUBLIC_INTEGRATION_API_BASE_URL=
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# —— Social sign-in (OAuth runs on NestJS; FE buttons redirect to BACKEND /auth/*) ——
# Configure GOOGLE_*, GITHUB_*, FACEBOOK_* in NEXA backend .env (see NEXA/.env.example).
# After provider login, user returns to {AUTH_URL}/auth/oauth to set session cookies.
AUTH_URL=http://localhost:3001
# App URL for links in emails (verification + password reset). NestJS should build links with this host.
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Example verification link: {NEXT_PUBLIC_APP_URL}/auth/verify-email/confirm?token=...
# Example password reset link: {NEXT_PUBLIC_APP_URL}/forgot-password/reset?token=...
