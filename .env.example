# Origin of your NestJS API (no trailing slash). When set, BFF routes proxy here with Bearer nexa_access_token when present.
NEXT_PUBLIC_BACKEND_API_BASE_URL=http://localhost:3000
# Canonical public site base (Next app URL, no trailing slash) — matches Nest FRONTEND_PUBLIC_URL
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Optional upstream overrides (defaults match Nest websites module):
# BACKEND_USER_WEBSITES_PATH=/websites
# BACKEND_USER_WEBSITE_DETAIL_PATH=/websites/:id
# PUT /api/user/websites/:id → /websites/:id/builder (fixed in upstream-paths)
# POST …/publish → /websites/:id/publish | …/generate-content → /websites/:id/generate-content
# BACKEND_WEBSITE_TEMPLATES_PATH=/websites/templates
# Optional server-only path for the dashboard aggregate (default /dashboard). Example: /api/v1/me/dashboard
BACKEND_DASHBOARD_PATH=
NEXT_PUBLIC_WEBSITE_API_BASE_URL=
NEXT_PUBLIC_CHATBOT_API_BASE_URL=
NEXT_PUBLIC_INTEGRATION_API_BASE_URL=
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# —— OAuth (use with Auth.js / NextAuth or your own callback routes) ——
# Random secret for session signing (e.g. openssl rand -base64 32)
AUTH_SECRET=
# App URL for redirect base, e.g. http://localhost:3000
AUTH_URL=http://localhost:3000
# Google: https://console.cloud.google.com/apis/credentials — OAuth 2.0 Client (Web)
# Authorized redirect: {AUTH_URL}/api/auth/callback/google (or your library’s path)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# GitHub: https://github.com/settings/developers — OAuth App
# Authorization callback URL: {AUTH_URL}/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Meta / Facebook: https://developers.facebook.com — App → Facebook Login → Settings
# Valid OAuth Redirect URIs: {AUTH_URL}/api/auth/callback/facebook
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=
