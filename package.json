{
  "name": "nexa-fe",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node scripts/run-cli.cjs next dev --webpack -H 0.0.0.0 -p 3001",
    "dev:turbo": "node scripts/run-cli.cjs next dev --turbopack -H 0.0.0.0 -p 3001",
    "build": "node scripts/run-cli.cjs next build",
    "start": "node scripts/start.cjs",
    "share": "npm run build && npm run start",
    "lint": "node scripts/run-cli.cjs next lint",
    "typecheck": "node scripts/run-cli.cjs tsc --noEmit"
  },
  "dependencies": {
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest"
  },
  "devDependencies": {
    "eslint": "latest",
    "eslint-config-next": "latest"
  }
}
